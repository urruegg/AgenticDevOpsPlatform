{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/urruegg/AgenticDevOpsPlatform/schemas/landing-zone-spec.schema.json",
  "title": "Landing Zone Spec (UC1 input)",
  "description": "Strict schema for the WorkIQ MCP response that the spec-parser agent consumes. See agents/spec-parser/AGENT.md and sprints/sprint-02-uc1-spec-parser-happy-path.md §S2-2.",
  "type": "object",
  "required": ["specVersion", "metadata", "subscription", "network", "tags"],
  "additionalProperties": false,
  "properties": {
    "specVersion": {
      "type": "string",
      "description": "Semantic version of the spec contract.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "metadata": {
      "type": "object",
      "required": ["workloadName", "owner", "costCenter", "environment"],
      "additionalProperties": false,
      "properties": {
        "workloadName": {
          "type": "string",
          "description": "Short, lowercase workload identifier used as the suffix for every resource name.",
          "pattern": "^[a-z][a-z0-9-]{2,23}$"
        },
        "owner": {
          "type": "string",
          "description": "Email of the responsible team or owner.",
          "format": "email"
        },
        "costCenter": {
          "type": "string",
          "description": "Cost center identifier applied as a resource tag.",
          "pattern": "^[A-Z0-9-]{2,16}$"
        },
        "environment": {
          "type": "string",
          "description": "Target environment for this spec run.",
          "enum": ["dev", "test", "stg", "prod"]
        }
      }
    },
    "subscription": {
      "type": "object",
      "required": ["targetSubscriptionId", "primaryRegion", "resourceGroupName"],
      "additionalProperties": false,
      "properties": {
        "targetSubscriptionId": {
          "type": "string",
          "description": "Azure subscription GUID the landing zone targets.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "primaryRegion": {
          "type": "string",
          "description": "Azure region short name (e.g., westeurope, eastus2).",
          "pattern": "^[a-z]{4,20}[0-9]?$"
        },
        "resourceGroupName": {
          "type": "string",
          "description": "Resource group name. Must follow the platform naming convention.",
          "pattern": "^rg-[a-z][a-z0-9-]{2,40}-(dev|test|stg|prod)$"
        }
      }
    },
    "network": {
      "type": "object",
      "required": ["vnetCidr", "subnets"],
      "additionalProperties": false,
      "properties": {
        "vnetCidr": {
          "type": "string",
          "description": "VNet IPv4 CIDR. Must be /16 or smaller (i.e., /16..../24).",
          "pattern": "^(10|172|192)\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}/(1[6-9]|2[0-4])$"
        },
        "subnets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["name", "cidr"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{2,30}$"
              },
              "cidr": {
                "type": "string",
                "description": "Subnet CIDR (/24..../29).",
                "pattern": "^(10|172|192)\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}/(2[4-9])$"
              },
              "delegations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^Microsoft\\.[A-Za-z]+/[A-Za-z]+$"
                },
                "default": []
              }
            }
          }
        }
      }
    },
    "tags": {
      "type": "object",
      "description": "Required tags applied to every resource (platform convention, copilot-instructions §8).",
      "required": ["env", "owner", "costCenter", "workload"],
      "additionalProperties": false,
      "properties": {
        "env": { "type": "string", "enum": ["dev", "test", "stg", "prod"] },
        "owner": { "type": "string", "format": "email" },
        "costCenter": { "type": "string", "pattern": "^[A-Z0-9-]{2,16}$" },
        "workload": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,23}$" }
      }
    }
  }
}
